[Unit]
Description=Limit Mail-Buddy HTTPS to the home LAN
Requires=docker.service
After=docker.service network-online.target
Before=mail-buddy.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mail-buddy/firewall.env
ExecStart=/opt/mail-buddy/scripts/configure-firewall.sh
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
