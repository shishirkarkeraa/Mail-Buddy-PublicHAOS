# Copy to .env. Never put passwords, encryption keys, or OAuth JSON here.
# macOS local-only: localhost
# Raspberry Pi LAN: mail-buddy.local or a private DNS name for the Pi
MAIL_BUDDY_HOSTNAME=mail-buddy.local
# macOS local-only: 127.0.0.1
# Raspberry Pi LAN: the Pi's fixed private IPv4 address after firewall setup
MAIL_BUDDY_BIND_ADDRESS=127.0.0.1
# Directory containing mode-0600 secret files. Docker imports them into a
# private named volume with the container application's uid on every fresh
# deployment, avoiding host uid differences between Linux and macOS.
MAIL_BUDDY_SECRETS_DIR=./secrets

MAIL_BUDDY_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# Optional laptop-primary endpoint. Use only the laptop's fixed private/Tailscale
# IP; public hosts and DNS names are intentionally rejected. Leave blank to use
# only the Pi's local Ollama service.
MAIL_BUDDY_OLLAMA_PRIMARY_URL=
MAIL_BUDDY_POLL_INTERVAL_SECONDS=120
MAIL_BUDDY_BACKFILL_PAGE_SIZE=500
MAIL_BUDDY_SAMPLE_SIZE=25
MAIL_BUDDY_MAX_MODEL_INPUT_CHARS=8000
MAIL_BUDDY_OLLAMA_TIMEOUT_SECONDS=120
MAIL_BUDDY_OLLAMA_CONNECT_TIMEOUT_SECONDS=3
MAIL_BUDDY_WORKER_IDLE_SECONDS=1
MAIL_BUDDY_PERSONALIZATION_ENABLED=true
MAIL_BUDDY_TRAINING_INTERVAL_DAYS=7
MAIL_BUDDY_TRAINING_HOUR_LOCAL=2
MAIL_BUDDY_SESSION_MAX_AGE_SECONDS=43200
MAIL_BUDDY_LOGIN_ATTEMPTS=5
MAIL_BUDDY_LOGIN_WINDOW_SECONDS=300
MAIL_BUDDY_COLLEGE_DOMAINS=
MAIL_BUDDY_LOG_LEVEL=INFO
TZ=Asia/Kolkata

# SQLite is always local in the mail_buddy_data Docker volume. There is no
# DATABASE_URL and no external database connection to configure.
