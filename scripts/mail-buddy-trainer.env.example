# Copy to ~/.config/mail-buddy/trainer.env and chmod 600.
MAIL_BUDDY_PI_SSH_HOST=mailbuddy-trainer@192.168.1.50
MAIL_BUDDY_PI_SSH_KEY=/Users/your-user/.ssh/mail_buddy_trainer_ed25519
MAIL_BUDDY_MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
MAIL_BUDDY_LAPTOP_OLLAMA_URL=http://127.0.0.1:11434
MAIL_BUDDY_LLAMA_CPP_DIR=/Users/your-user/Developer/llama.cpp
# Pin these after building llama.cpp; never use a branch name here.
MAIL_BUDDY_LLAMA_CPP_COMMIT=REPLACE_WITH_40_CHARACTER_COMMIT
MAIL_BUDDY_LLAMA_QUANTIZE_SHA256=REPLACE_WITH_64_CHARACTER_SHA256
MAIL_BUDDY_TRAINER_MIN_FREE_KIB=20971520
